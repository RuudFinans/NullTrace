# Render security settings for 0trace.xyz. Preserve your existing secrets/database.
# Local HTTP development only: use NT_ENV=dev, SESSION_COOKIE_SECURE=0 and
# NT_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000.
NT_ENV=prod
NT_ALLOWED_ORIGINS=https://0trace.xyz
SESSION_COOKIE_SECURE=1
NT_VISITOR_METRICS=0

# No proxy CIDR setting or Redis is needed. Use python -m backend.serve.
# The launcher selects one web process automatically; WEB_CONCURRENCY is optional.
# One process handles multiple simultaneous users. Keep one Render instance.
# Protocol v3 ratchets run in the browser using committed WASM assets.
# No ratchet environment variables or extra Render services are required.

NULLTRACE_PRICE_1M_USD=100
NULLTRACE_PRICE_6M_USD=400
NULLTRACE_PRICE_1Y_USD=600

# This example uses test payments. For real payments in Render, use 0.
SOL_USE_DEVNET=1
SOLANA_RPC_DEV=https://api.devnet.solana.com
SOLANA_RPC_MAIN=https://api.mainnet-beta.solana.com
SOLANA_COLD_WALLET_PUBLIC_KEY=
DEVNET_PAYMENT_FAUCET_ENABLED=0
DEVNET_PAYMENT_FAUCET_MAX_LAMPORTS=2000000000

SOL_PRICE_PROVIDER=coingecko
SOL_PRICE_CACHE_SECONDS=300
SOL_PRICE_USD_FALLBACK=

PAYMENT_FINALITY=finalized
PAYMENT_POLL_INTERVAL_SECONDS=10
PAYMENT_EXPIRES_MINUTES=30

SWEEP_ENABLED=1
SWEEP_AFTER_SECONDS=60
SWEEP_POLL_INTERVAL_SECONDS=60
SWEEP_MIN_BALANCE_LAMPORTS=5000
SWEEP_RETRY_SECONDS=120

ACCESS_KEY_PEPPER_BASE64=
SESSION_SECRET_BASE64=
DEPOSIT_WALLET_ENCRYPTION_KEY_BASE64=

ACTIVE_SESSION_HEARTBEAT_SECONDS=60
SESSION_MAX_INACTIVE_SECONDS=180
RESTORE_RESET_COOLDOWN_SECONDS=300

INTERNAL_CRON_SECRET=

# Payment watcher and sweeper run inside the web app; no separate worker needed.
PAYMENT_BACKGROUND_WORKER_ENABLED=1
PAYMENT_BACKGROUND_RETRY_SECONDS=15

# Optional admin console. Leave both values empty to disable it.
# ADMIN_PATH becomes /<value>; production requires 24-128 random letters/digits/_/-.
# ADMIN_PASSWORD_HASH format: pbkdf2_sha256$iterations$salt_b64url$hash_b64url
# Production requires 600000-2000000 iterations. See README.md to generate a hash.
ADMIN_PATH=
ADMIN_PASSWORD_HASH=
