    "node": ">=24.22.1 <25"
  },
  "dependencies": {
    "libsodium-wrappers": "0.8.4",
    "mlkem": "2.7.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.64.1"
  },
  "scripts": {
    "build:libs": "esbuild frontend/static/libs-src/libsodium-entry.js --bundle --format=esm --platform=browser --minify --outfile=frontend/static/libs/libsodium-wrappers.bundle.js && esbuild frontend/static/libs-src/mlkem-entry.js --bundle --format=esm --platform=browser --minify --outfile=frontend/static/libs/mlkem.bundle.js",
    "test": "node --test tests/crypto.test.mjs tests/ratchet.test.mjs tests/group-ratchet.test.mjs"
  }
